структура РезультатСтруктура
    пер ТипРезультата: Строка
    пер Смещение: Число
    пер Длина: Число
    пер Значение: Строка
;

метод Скрипт()
    знч РезультатСжатия = СжатьДанные("оооооаааааууцочтшвалв")
    для Элемент из РезультатСжатия
        Консоль.Записать(Элемент)    
    ;
;

// Упрощенная реализация алгоритма LZ77
метод СжатьДанные(ВходныеДанные: Строка): Массив<РезультатСтруктура>
    
    знч Результат = новый Массив<РезультатСтруктура>()
    знч Длина = ВходныеДанные.Длина()
    пер Позиция = 0  // ИСПРАВЛЕНИЕ: меняем на индексацию с 0 для удобства
    знч РазмерБуфера = 1024 // Размер окна поиска
    
    пока Позиция < Длина
        
        пер МаксДлина = 0
        пер ЛучшееСмещение = 0
        
        // Начало области поиска в пределах окна
        знч НачалоПоиска = Макс(0, Позиция - РазмерБуфера)  // ИСПРАВЛЕНИЕ: индексация с 0
        
        // Проверяем что есть где искать
        если НачалоПоиска < Позиция 
            для Смещ = НачалоПоиска по Позиция - 1 
                пер ДлинаСовпадения = 0
                
                // ИСПРАВЛЕНИЕ: правильное использование Подстрока()
                пока (Смещ + ДлинаСовпадения) < Длина  
                      и (Позиция + ДлинаСовпадения) < Длина 
                      и ВходныеДанные.Подстрока(Смещ + ДлинаСовпадения, Смещ + ДлинаСовпадения + 1) == ВходныеДанные.Подстрока(Позиция + ДлинаСовпадения, Позиция + ДлинаСовпадения + 1)
                    ДлинаСовпадения = ДлинаСовпадения + 1
                ;
                
                если ДлинаСовпадения > МаксДлина
                    МаксДлина = ДлинаСовпадения
                    ЛучшееСмещение = Позиция - Смещ
                ;
            ;
        ;
        
        если МаксДлина > 2
            // Добавляем ссылку (смещение, длина)
            знч НоваяСтруктура = новый РезультатСтруктура()
            НоваяСтруктура.ТипРезультата = "Ссылка"
            НоваяСтруктура.Смещение = ЛучшееСмещение
            НоваяСтруктура.Длина = МаксДлина
            НоваяСтруктура.Значение = ""
            Результат.Добавить(НоваяСтруктура)
            Позиция = Позиция + МаксДлина
        иначе
            // Добавляем литерал (один символ)
            знч Символ = ВходныеДанные.Подстрока(Позиция, Позиция + 1)  // ИСПРАВЛЕНИЕ: берем 1 символ
            знч НоваяСтруктура = новый РезультатСтруктура()
            НоваяСтруктура.ТипРезультата = "Литерал"
            НоваяСтруктура.Смещение = 0
            НоваяСтруктура.Длина = 0
            НоваяСтруктура.Значение = Символ
            Результат.Добавить(НоваяСтруктура)
            Позиция = Позиция + 1
        ;
        
    ;
    
    возврат Результат.Фильтровать(Элемент->Элемент.ТипРезультата == "Ссылка")
;