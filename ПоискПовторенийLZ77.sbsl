// --------------------------------------------------------------
//  УПРОЩЁННАЯ РЕАЛИЗАЦИЯ АЛГОРИТМА LZ77
// --------------------------------------------------------------
//  Принцип работы:
//  - Проходим строку посимвольно.
//  - В пределах "скользящего окна" ищем уже встречавшиеся фрагменты.
//  - Если нашли совпадение длиной более 2 символов — сохраняем ссылку.
//  - Иначе — сохраняем сам символ ("литерал").
// --------------------------------------------------------------
метод Скрипт()
    знч Вход = "оооооарыирххххтыииyyyyy"
    знч РезультатСжатия = СжатьДанные(Вход)
    
    // Вывод результата
    для Элемент из РезультатСжатия 
        Консоль.Записать(Элемент)
    ;
;


// --------------------------------------------------------------
//  МЕТОД СЖАТИЯ ДАННЫХ ПО LZ77
// --------------------------------------------------------------
метод СжатьДанные(ВходныеДанные: Строка): Массив<Строка>

    знч Результат = новый Массив<Строка>()
    знч Длина = ВходныеДанные.Длина()
    пер Позиция = 0
    знч РазмерБуфера = 256 // Размер "окна" (истории поиска)
    
    пока Позиция < Длина 
        
        пер МаксДлина = 0
        пер ЛучшееСмещение = 0
        
        // Текущий символ (один)
        знч ТекСимвол = ВходныеДанные.Символ(Позиция)
        
        // ----------------------------------------------------------
        //  Быстрая проверка — если символ не повторяется рядом,
        //  нет смысла искать совпадения в буфере.
        // ----------------------------------------------------------
        если Позиция + 1 < Длина и ТекСимвол != ВходныеДанные.Символ(Позиция + 1)
            Результат.Добавить("Литерал: $ТекСимвол")
            Позиция += 1
            продолжить
        ;
        
        // ----------------------------------------------------------
        //  Определяем границы поиска в "окне"
        // ----------------------------------------------------------
        знч НачалоПоиска = Макс(0, Позиция - РазмерБуфера)
        знч КонецПоиска = Позиция - 1
        
        // ----------------------------------------------------------
        //  Перебираем все возможные позиции в окне (с конца к началу)
        // ----------------------------------------------------------
        для Смещение = КонецПоиска вниз по НачалоПоиска 
            
            // Быстрая проверка первого символа
            если ВходныеДанные.Символ(Смещение) != ТекСимвол 
                продолжить
            ;
            
            // ------------------------------------------------------
            //  Считаем длину совпадения
            // ------------------------------------------------------
            пер ДлинаСовпадения = 1
            знч МаксВозможнаяДлина = Мин(Длина - Позиция, 258)
            
            пока (ДлинаСовпадения < МаксВозможнаяДлина) и
                  (ВходныеДанные.Подстрока(Смещение + ДлинаСовпадения, Смещение + ДлинаСовпадения + 1)
                      == ВходныеДанные.Подстрока(Позиция + ДлинаСовпадения, Позиция + ДлинаСовпадения + 1)) 
                
                ДлинаСовпадения = ДлинаСовпадения + 1
            ;
            
            // ------------------------------------------------------
            //  Если нашли лучшее совпадение — запоминаем
            // ------------------------------------------------------
            если ДлинаСовпадения > МаксДлина 
                МаксДлина = ДлинаСовпадения
                ЛучшееСмещение = Позиция - Смещение
                
                // Если нашли длинное совпадение, можно прервать поиск
                если МаксДлина > 32 
                    прервать
                ;
            ;
        ;
        
        // ----------------------------------------------------------
        //  Формируем результат: ссылка или литерал
        // ----------------------------------------------------------
        если МаксДлина > 2 
            Результат.Добавить("Ссылка: смещение = $ЛучшееСмещение, длина =  $МаксДлина")
            Позиция = Позиция + МаксДлина
        иначе
            Результат.Добавить("Литерал: $ТекСимвол")
            Позиция += 1
        ;
        
    ;
    возврат Результат
;
